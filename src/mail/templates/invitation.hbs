<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background:#f0f0f0">
  <table
    width="600"
    align="center"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="margin:40px auto;background:#fff;border-radius:8px;overflow:hidden"
  >
    <tr>
      <td>{{> header}}</td>
    </tr>

    <tr>
      <td style="padding:32px;font-family:Arial,Helvetica,sans-serif;color:#333">
        <h2 style="margin-top:0">
          You're invited to join {{orgName}}
        </h2>

        <p style="line-height:1.6;">
          Hello,
        </p>

        <p style="line-height:1.6;">
          <strong>{{inviterName}}</strong> has invited you to join
          <strong>{{orgName}}</strong> as a
          <strong>{{role}}</strong>.
        </p>

        <p style="line-height:1.6;">
          Please choose whether you'd like to accept or decline this invitation.
        </p>

        <table
          role="presentation"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="margin:24px 0;"
        >
          <tr>
            <td>
              <a
                href="{{invitationUrl}}"
                style="
                  display:inline-block;
                  padding:12px 28px;
                  background:#4f46e5;
                  color:#ffffff;
                  text-decoration:none;
                  border-radius:6px;
                  font-family:Arial,Helvetica,sans-serif;
                  font-weight:bold;
                "
              >
                Accept Invitation
              </a>
            </td>

            <td style="width:12px;"></td>

            <td>
              <a
                href="{{declineInvitationUrl}}"
                style="
                  display:inline-block;
                  padding:12px 28px;
                  background:#dc2626;
                  color:#ffffff;
                  text-decoration:none;
                  border-radius:6px;
                  font-family:Arial,Helvetica,sans-serif;
                  font-weight:bold;
                "
              >
                Decline Invitation
              </a>
            </td>
          </tr>
        </table>

        <p style="font-size:13px;color:#999;line-height:1.6;">
          This invitation will expire in 48 hours.
        </p>

        <p style="font-size:13px;color:#999;line-height:1.6;">
          If you were not expecting this invitation, you can safely ignore this email.
        </p>
      </td>
    </tr>

    <tr>
      <td>{{> footer}}</td>
    </tr>
  </table>
</body>
</html>