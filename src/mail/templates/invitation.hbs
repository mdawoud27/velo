<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background:#f0f0f0">
  <table width="600" align="center" style="margin:40px auto;background:#fff;border-radius:8px;overflow:hidden">
    <tr>
      <td>{{> header}}</td>
    </tr>

    <tr>
      <td style="padding:32px;font-family:sans-serif;color:#333">
        <h2>You're invited to join {{orgName}}</h2>

        <p style="line-height:1.6">
          Hello,
        </p>

        <p style="line-height:1.6">
          <strong>{{inviterName}}</strong> has invited you to join
          <strong>{{orgName}}</strong> as a
          <strong>{{role}}</strong>.
        </p>

        <p style="line-height:1.6">
          Click the button below to accept the invitation and become a member of the organization.
        </p>

        <a
          href="{{invitationUrl}}"
          style="display:inline-block;margin:16px 0;padding:12px 28px;background:#4f46e5;color:#fff;text-decoration:none;border-radius:6px;font-family:sans-serif"
        >
          Accept Invitation
        </a>

        <p style="font-size:13px;color:#999;line-height:1.6">
          This invitation will expire in 48 hours.
        </p>

        <p style="font-size:13px;color:#999;line-height:1.6">
          If you were not expecting this invitation, you can safely ignore this email.
        </p>
      </td>
    </tr>

    <tr>
      <td>{{> footer}}</td>
    </tr>
  </table>
</body>
</html>