<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background:#f0f0f0">
  <table width="600" align="center" style="margin:40px auto;background:#fff;border-radius:8px;overflow:hidden">
    <tr><td>{{> header}}</td></tr>
    <tr>
      <td style="padding:32px;font-family:sans-serif;color:#333">
        <h2>Hi {{name}}, new comment</h2>
        <p style="line-height:1.6"><strong>{{commenterName}}</strong> commented on <strong>"{{taskTitle}}"</strong>:</p>
        <blockquote style="margin:16px 0;padding:12px 16px;background:#f9fafb;border-left:4px solid #4f46e5;color:#555">
          {{commentBody}}
        </blockquote>
        <a href="{{taskUrl}}"
           style="display:inline-block;margin:16px 0;padding:12px 28px;background:#4f46e5;color:#fff;text-decoration:none;border-radius:6px;font-family:sans-serif">
          View Comment
        </a>
      </td>
    </tr>
    <tr><td>{{> footer}}</td></tr>
  </table>
</body>
</html>
