# Velo - Environment Configuration
# Copy this file to .env and fill in your own values.

# Database
# PostgreSQL connection string (Neon, Supabase, or self-hosted)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Direct connection URL (used by Prisma for migrations, bypassing connection poolers)
# Leave empty if your DATABASE_URL already points directly to the DB
DIRECT_URL=""

# Redis
# Redis connection string (Upstash, Redis Cloud, or self-hosted)
# Format: redis://USER:PASSWORD@HOST:PORT
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Application
# URL of your frontend app (used for CORS and redirect URLs)
FRONTEND_URL="http://localhost:5173"

# Server port
PORT=3000

# Node environment: development | production | test
NODE_ENV="development"

# Base URL of this backend (used for callbacks and links)
CLIENT_URL="http://localhost:3000"

# JWT Secrets (generate strong random strings)
# Use: openssl rand -base64 64
JWT_ACCESS_SECRET="your_access_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your_refresh_secret_here"
JWT_REFRESH_EXPIRES_IN="7d"

JWT_2FA_CHALLENGE_SECRET="your_2fa_challenge_secret_here"
JWT_2FA_CHALLENGE_EXPIRES_IN="5m"

# Session
# Generate with: openssl rand -base64 32
SESSION_SECRET="your_session_secret_here"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL_DEV="http://localhost:3000/api/v1/auth/google/callback"
GOOGLE_CALLBACK_URL_PROD="https://your-domain.com/api/v1/auth/google/callback"

# GitHub OAuth

# Production
GITHUB_CLIENT_ID_PROD="your_github_client_id_prod"
GITHUB_CLIENT_SECRET_PROD="your_github_client_secret_prod"
GITHUB_CALLBACK_URL_PROD="https://your-domain.com/api/v1/auth/github/callback"

# Development
GITHUB_CLIENT_ID_DEV="your_github_client_id_dev"
GITHUB_CLIENT_SECRET_DEV="your_github_client_secret_dev"
GITHUB_CALLBACK_URL_DEV="http://localhost:3000/api/v1/auth/github/callback"

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRO_PRICE_ID="price_your_pro_price_id"
STRIPE_BUSINESS_PRICE_ID="price_your_business_price_id"

# Groq (AI)
GROQ_API_KEY="gsk_your_groq_api_key"
AI_RATE_LIMIT_PER_HOUR="100"

# Cloudinary (Media Uploads)
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET="your_cloudinary_api_secret"

# SMTP (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password_or_smtp_password"
EMAIL_FROM="your_email@gmail.com"

# Docker (Local Development)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="velo"
POSTGRES_PORT=5432
REDIS_PORT=6379